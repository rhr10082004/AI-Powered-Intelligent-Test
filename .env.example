# Application Environment
ENVIRONMENT=development
NODE_ENV=development

# Database
DB_USER=testprep
DB_PASSWORD=testprep_dev_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=testprep_db
DATABASE_URL=postgresql://testprep:testprep_dev_password@postgres:5432/testprep_db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=testprep_qdrant_key

# JWT & Security
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=4

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Intelligent Test Prep Platform
NEXT_PUBLIC_APP_DESCRIPTION=AI-Powered Test Preparation Platform

# External APIs
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=noreply@testprep.local

# AWS S3 / Object Storage
S3_BUCKET=testprep-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_aws_access_key
S3_SECRET_ACCESS_KEY=your_aws_secret_key
S3_ENDPOINT_URL=http://minio:9000  # For local MinIO development

# Speech Recognition
SPEECH_RECOGNITION_SERVICE=openai  # Options: openai, google_cloud, azure
GOOGLE_CLOUD_SPEECH_API_KEY=your_google_cloud_api_key

# OCR Service
OCR_SERVICE=tesseract  # Options: tesseract, google_cloud, azure
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_api_key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_MOCK_LLM=false
ENABLE_ANALYTICS=true
ENABLE_GAMIFICATION=true

# Testing
TEST_DATABASE_URL=postgresql://testprep:testprep_dev_password@localhost:5432/testprep_test_db
